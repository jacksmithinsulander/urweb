// Ur/Web LALRPOP grammar
//
// This is a faithful skeleton of the urweb.grm ML-Yacc grammar, ported to
// LALRPOP syntax.  Phase 1 provides the full structure with `todo!()` actions;
// subsequent phases will fill in the AST construction.
//
// **Strictness**: `build.rs` runs LALRPOP with conflicts as hard errors — ambiguous
// parse tables must not be generated or silently resolved. Prefer grammar refactors
// over suppressing conflicts.
//
// Token names match crate::parse::lexical_analyzer::Token variant names.

use crate::error_types::{Located, Span};
use crate::source::*;
use crate::parse::grammar_helpers::con_record_field_pun;
use crate::parse::xml_helpers::{
    XmlAttr, XmlAttrsAcc, FunParam, capitalize_attr, xml_attrs_push, xml_desugar_tag_open,
    xml_empty_cdata, wrap_fun_params, str_to_decl_open,
};

grammar;

// ---------------------------------------------------------------------------
// External token declaration — use our logos-based lexer
// ---------------------------------------------------------------------------

extern {
    type Location = usize;
    type Error = crate::parse::lexical_analyzer::LexError;

    enum crate::parse::lexical_analyzer::Token {
        // Literals
        "INT"     => crate::parse::lexical_analyzer::Token::Int(<i64>),
        "FLOAT"   => crate::parse::lexical_analyzer::Token::Float(<f64>),
        "STRING"  => crate::parse::lexical_analyzer::Token::String(<String>),
        "CHAR"    => crate::parse::lexical_analyzer::Token::Char(<char>),

        // Keywords
        "and"       => crate::parse::lexical_analyzer::Token::And,
        "andalso"   => crate::parse::lexical_analyzer::Token::Andalso,
        "case"      => crate::parse::lexical_analyzer::Token::Case,
        "class"     => crate::parse::lexical_analyzer::Token::Class,
        "con"       => crate::parse::lexical_analyzer::Token::Con,
        "constraint"  => crate::parse::lexical_analyzer::Token::Constraint,
        "constraints" => crate::parse::lexical_analyzer::Token::Constraints,
        "cookie"    => crate::parse::lexical_analyzer::Token::Cookie,
        "datatype"  => crate::parse::lexical_analyzer::Token::Datatype,
        "else"      => crate::parse::lexical_analyzer::Token::Else,
        "end"       => crate::parse::lexical_analyzer::Token::End,
        "export"    => crate::parse::lexical_analyzer::Token::Export,
        "false"     => crate::parse::lexical_analyzer::Token::False,
        "ffi"       => crate::parse::lexical_analyzer::Token::Ffi,
        "fn"        => crate::parse::lexical_analyzer::Token::Fn,
        "fun"       => crate::parse::lexical_analyzer::Token::Fun,
        "functor"   => crate::parse::lexical_analyzer::Token::Functor,
        "if"        => crate::parse::lexical_analyzer::Token::If,
        "in"        => crate::parse::lexical_analyzer::Token::In,
        "include"   => crate::parse::lexical_analyzer::Token::Include,
        "let"       => crate::parse::lexical_analyzer::Token::Let,
        "map"       => crate::parse::lexical_analyzer::Token::Map,
        "of"        => crate::parse::lexical_analyzer::Token::Of,
        "open"      => crate::parse::lexical_analyzer::Token::Open,
        "orelse"    => crate::parse::lexical_analyzer::Token::Orelse,
        "policy"    => crate::parse::lexical_analyzer::Token::Policy,
        "rec"       => crate::parse::lexical_analyzer::Token::Rec,
        "sequence"  => crate::parse::lexical_analyzer::Token::Sequence,
        "sig"       => crate::parse::lexical_analyzer::Token::Sig,
        "signature" => crate::parse::lexical_analyzer::Token::Signature,
        "struct"    => crate::parse::lexical_analyzer::Token::Struct,
        "structure" => crate::parse::lexical_analyzer::Token::Structure,
        "style"     => crate::parse::lexical_analyzer::Token::Style,
        "table"     => crate::parse::lexical_analyzer::Token::Table,
        "task"      => crate::parse::lexical_analyzer::Token::Task,
        "then"      => crate::parse::lexical_analyzer::Token::Then,
        "true"      => crate::parse::lexical_analyzer::Token::True,
        "type"      => crate::parse::lexical_analyzer::Token::Type,  // ltype in SML grammar
        "val"       => crate::parse::lexical_analyzer::Token::Val,
        "view"      => crate::parse::lexical_analyzer::Token::View,
        "sgn_where" => crate::parse::lexical_analyzer::Token::Where,
        "sgn_subwhere" => crate::parse::lexical_analyzer::Token::SgnSubwhere,
        "Name"      => crate::parse::lexical_analyzer::Token::Name,
        "Type"      => crate::parse::lexical_analyzer::Token::KindType,
        "Unit"      => crate::parse::lexical_analyzer::Token::KindUnit,

        // Operators & punctuation
        "("   => crate::parse::lexical_analyzer::Token::Lparen,
        ")"   => crate::parse::lexical_analyzer::Token::Rparen,
        "["   => crate::parse::lexical_analyzer::Token::Lbrack,
        "]"   => crate::parse::lexical_analyzer::Token::Rbrack,
        "{"   => crate::parse::lexical_analyzer::Token::Lbrace,
        "}"   => crate::parse::lexical_analyzer::Token::Rbrace,
        "()"  => crate::parse::lexical_analyzer::Token::Unit,
        "->"  => crate::parse::lexical_analyzer::Token::Arrow,
        "=>"  => crate::parse::lexical_analyzer::Token::Darrow,
        "case_bar" => crate::parse::lexical_analyzer::Token::CaseBar,
        "arm_sep" => crate::parse::lexical_analyzer::Token::ArmSep,
        "case_end" => crate::parse::lexical_analyzer::Token::CaseEnd,
        "dtype_of" => crate::parse::lexical_analyzer::Token::DtypeOf,
        "dt_con0" => crate::parse::lexical_analyzer::Token::DtCon0,
        "dt_bar" => crate::parse::lexical_analyzer::Token::DtBar,
        "dt_done" => crate::parse::lexical_analyzer::Token::DtDone,
        "==>" => crate::parse::lexical_analyzer::Token::Dkarrow,
        "-->" => crate::parse::lexical_analyzer::Token::Karrow,
        "++"  => crate::parse::lexical_analyzer::Token::Plusplus,
        "--"  => crate::parse::lexical_analyzer::Token::Minusminus,
        "---" => crate::parse::lexical_analyzer::Token::Minusminusminus,
        "^"   => crate::parse::lexical_analyzer::Token::Caret,
        "="   => crate::parse::lexical_analyzer::Token::Eq,
        "<>"  => crate::parse::lexical_analyzer::Token::Ne,
        "<"   => crate::parse::lexical_analyzer::Token::Lt,
        ">"   => crate::parse::lexical_analyzer::Token::Gt,
        "<="  => crate::parse::lexical_analyzer::Token::Le,
        ">="  => crate::parse::lexical_analyzer::Token::Ge,
        ","   => crate::parse::lexical_analyzer::Token::Comma,
        ":::" => crate::parse::lexical_analyzer::Token::Tcolonwild,
        "::"  => crate::parse::lexical_analyzer::Token::Dcolon,
        "::::" => crate::parse::lexical_analyzer::Token::Dcolonwild,
        ":"   => crate::parse::lexical_analyzer::Token::Colon,
        "..." => crate::parse::lexical_analyzer::Token::Dotdotdot,
        "."   => crate::parse::lexical_analyzer::Token::Dot,
        "$"   => crate::parse::lexical_analyzer::Token::Dollar,
        "#"   => crate::parse::lexical_analyzer::Token::Hash,
        "___" => crate::parse::lexical_analyzer::Token::Underunderunder,
        "__"  => crate::parse::lexical_analyzer::Token::Underunder,
        "_"   => crate::parse::lexical_analyzer::Token::Under,
        "WILDANNOT" => crate::parse::lexical_analyzer::Token::WildAnnot,
        "~"   => crate::parse::lexical_analyzer::Token::Twiddle,
        "|"   => crate::parse::lexical_analyzer::Token::Bar,
        "*"   => crate::parse::lexical_analyzer::Token::Star,
        "<-"  => crate::parse::lexical_analyzer::Token::Larrow,
        ";"   => crate::parse::lexical_analyzer::Token::Semi,
        "!"   => crate::parse::lexical_analyzer::Token::Bang,
        "+"   => crate::parse::lexical_analyzer::Token::Plus,
        "-"   => crate::parse::lexical_analyzer::Token::Minus,
        "/"   => crate::parse::lexical_analyzer::Token::Divide,
        "%"   => crate::parse::lexical_analyzer::Token::Mod,
        "@"   => crate::parse::lexical_analyzer::Token::At,
        "|>"  => crate::parse::lexical_analyzer::Token::Fwdapp,
        "<|"  => crate::parse::lexical_analyzer::Token::Revapp,

        // Identifiers
        "IDENT"  => crate::parse::lexical_analyzer::Token::Ident(<String>),
        "UIDENT" => crate::parse::lexical_analyzer::Token::UpperIdent(<String>),
        "SYMBOL" => crate::parse::lexical_analyzer::Token::Csymbol(<String>),
        "XML_ATTR_NAME_EQ" => crate::parse::lexical_analyzer::Token::XmlAttrNameEq(<String>),
        "XML_ATTR_NAME_BARE" => crate::parse::lexical_analyzer::Token::XmlAttrNameBare(<String>),
        "BACKTICK_PATH" => crate::parse::lexical_analyzer::Token::BacktickPath(<String>),

        // XML
        "BEGIN_TAG"    => crate::parse::lexical_analyzer::Token::BeginTag(<String>),
        "END_TAG"      => crate::parse::lexical_analyzer::Token::EndTag(<String>),
        "XML_BEGIN_END" => crate::parse::lexical_analyzer::Token::XmlBeginEnd,
        "NOTAGS"       => crate::parse::lexical_analyzer::Token::Notags(<String>),
    }
}

// ---------------------------------------------------------------------------
// Start symbol
// ---------------------------------------------------------------------------

pub File: File = {
    <decls:Decl*> => decls,
};

/// Entry point for `.urs` signature files: the caller wraps the input in
/// `sig … end` so we parse a sequence of signature items directly.
pub SgnItems: Vec<LocSgnItem> = {
    <items:SgnItem*> => items,
};

// ---------------------------------------------------------------------------
// Declarations
// ---------------------------------------------------------------------------

Decl: LocDecl = {
    <l:@L> <d:DeclNode> <r:@R> => Located::new(d, Span::from_offsets("", l, r, &[])),
};

DeclNode: Decl = {
    // val p = e
    "val" <p:Pat> "=" <e:NonSeqExp> => Decl::Val(p, e),

    // val rec f : t = e and ...
    "val" "rec" <binds:ValRecBindings> => Decl::ValRec(binds),

    // fun f x = e and ...
    "fun" <binds:FunBindings> => {
        // Desugar fun bindings to val rec
        Decl::ValRec(binds)
    },

    // type / con declaration (`type` is a synonym for `con`)
    "con" <name:"IDENT"> <k:KindAnnot?> "=" <c:Con> =>
        Decl::Con(name, k.map(Box::new), c),
    "type" <name:"IDENT"> <k:KindAnnot?> "=" <c:Con> =>
        Decl::Con(name, k.map(Box::new), c),

    // datatype
    "datatype" <dts:DatatypeDecls> => Decl::Datatype(dts),

    // signature
    "signature" <name:"UIDENT"> "=" <s:Sgn> => Decl::Sgn(name, s),

    // structure
    "structure" <name:"UIDENT"> <annot:SgnAnnot?> "=" <st:Str> =>
        Decl::Str(name, annot, None, st, false),

    // open — accepts any structure expression (module path or functor application)
    "open" <s:Str> => str_to_decl_open(s),

    // functor
    "functor" <name:"UIDENT"> "(" <arg:"UIDENT"> ":" <s:Sgn> ")" <ret:SgnAnnot?> "=" <body:Str> =>
        Decl::Str(name, None, None, Located::dummy(Str::Fun(arg, s, ret, Box::new(body))), false),

    "table" <name:"IDENT"> ":" <c:Con> => {
        let z = Located::dummy(Exp::Record(vec![], false));
        Decl::Table(name, c, z.clone(), z)
    },

    "sequence" <name:"IDENT"> => Decl::Sequence(name),

    "view" <name:"IDENT"> "=" <e:NonSeqExp> => Decl::View(name, e),

    "cookie" <name:"IDENT"> ":" <c:Con> => Decl::Cookie(name, c),

    "style" <name:"IDENT"> => Decl::Style(name),

    // task / policy / on_error
    "task" <e1:AppExp> "=" <e2:NonSeqExp> => Decl::Task(e1, e2),

    "policy" <e:NonSeqExp> => Decl::Policy(e),

    // export
    "export" <st:Str> => Decl::Export(st),

    // FFI
    "ffi" <name:"IDENT"> <modes:FfiModes> ":" <c:Con> => Decl::Ffi(name, modes, c),

    // constraint
    "constraint" <c1:Con> "~" <c2:Con> => Decl::Constraint(c1, c2),
};

// ---------------------------------------------------------------------------
// Module structures
// ---------------------------------------------------------------------------

Str: LocStr = {
    <l:@L> <s:StrNode> <r:@R> => Located::new(s, Span::from_offsets("", l, r, &[])),
};

// AppStr handles dot-projection to avoid shift/reduce conflict
AppStr: LocStr = {
    <l:@L> <s:AppStrInner> <r:@R> => Located::new(s, Span::from_offsets("", l, r, &[])),
};

AppStrInner: Str = {
    // Module projection: M.N — s is already LocStr, no need to re-wrap
    <s:AppStr> "." <field:"UIDENT"> => Str::Proj(Box::new(s), field),
    <s:AtomStr> => s.node,
};

AtomStr: LocStr = {
    <l:@L> <s:AtomStrNode> <r:@R> => Located::new(s, Span::from_offsets("", l, r, &[])),
};

AtomStrNode: Str = {
    <name:"UIDENT"> => Str::Var(name),
    "(" <s:Str> ")" => s.node,
};

StrNode: Str = {
    "struct" <decls:Decl*> "end" => Str::Const(decls),
    "functor" "(" <arg:"UIDENT"> ":" <sgn:Sgn> ")" <ret:SgnAnnot?> "=>" <body:Str> =>
        Str::Fun(arg, sgn, ret, Box::new(body)),
    <f:AppStr> "(" <x:Str> ")" => Str::App(Box::new(f), Box::new(x)),
    <s:AppStr> => s.node,
};

// ---------------------------------------------------------------------------
// Signatures
// ---------------------------------------------------------------------------
//
// `rewrite_sgn_where` emits `sgn_where` at paren depth 0 and `sgn_subwhere` when nested.
// `Sgn` is a flat alternation (no `SgnNoTopWhere = SgnPrimary` beside `Sgn = SgnPrimary sgn_where`)
// so at `SgnPrimary (*)` we only shift `sgn_where` / `sgn_subwhere` or reduce the bare arm — no
// reduce/reduce or shift/reduce with shared prefixes (LangSec / LR(1)).

Sgn: LocSgn = {
    <l:@L> <p:SgnPrimary> "sgn_where" <path:ModPath> "=" <w:Con> <r:@R> => {
        let mut pth = path;
        let last = pth.pop().unwrap_or_default();
        Located::new(Sgn::Where(Box::new(p), pth, last, w), Span::from_offsets("", l, r, &[]))
    },
    <l:@L> <p:SgnPrimary> "sgn_subwhere" <path:ModPath> "=" <w:Con> <r:@R> => {
        let mut pth = path;
        let last = pth.pop().unwrap_or_default();
        Located::new(Sgn::Where(Box::new(p), pth, last, w), Span::from_offsets("", l, r, &[]))
    },
    <f:SgnFunctor> => f,
    <p:SgnPrimary> => p,
};

SgnFunctor: LocSgn = {
    <l:@L> <n:SgnFunctorNode> <r:@R> => Located::new(n, Span::from_offsets("", l, r, &[])),
};

SgnFunctorNode: Sgn = {
    "functor" "(" <arg:"UIDENT"> ":" <s1:Sgn> ")" ":" <s2:Sgn> =>
        Sgn::Fun(arg, Box::new(s1), Box::new(s2)),
};

SgnPrimary: LocSgn = {
    <l:@L> <n:SgnPrimaryNode> <r:@R> => Located::new(n, Span::from_offsets("", l, r, &[])),
};

SgnPrimaryNode: Sgn = {
    "sig" <items:SgnItem*> "end" => Sgn::Const(items),
    <name:"UIDENT"> => Sgn::Var(name),
    "(" <s:Sgn> ")" => s.node,
};

SgnItem: LocSgnItem = {
    <l:@L> <si:SgnItemNode> <r:@R> => Located::new(si, Span::from_offsets("", l, r, &[])),
};

SgnItemNode: SgnItem = {
    // `type nm` (abstract) and `type nm = C` (defining) — no preprocessing needed.
    "type" <name:"IDENT"> "=" <c:Con> => SgnItem::Con(name, None, c),
    "type" <name:"IDENT"> => SgnItem::ConAbs(name, Box::new(Located::dummy(Kind::Type))),
    // `con nm = C` | `con nm :: K` (abstract) | `con nm :: K = C` (defining)
    // After `Kind`, lookahead `=` shifts (defining) while follow(SgnItem) ≠ `=` so no S/R conflict.
    "con" <name:"IDENT"> "=" <c:Con> => SgnItem::Con(name, None, c),
    "con" <name:"IDENT"> "::" <k:Kind> => SgnItem::ConAbs(name, Box::new(k)),
    "con" <name:"IDENT"> "::" <k:Kind> "=" <c:Con> =>
        SgnItem::Con(name, Some(Box::new(k)), c),
    "val" <name:"IDENT"> ":" <c:SigCon> => SgnItem::Val(name, c),
    "datatype" <dts:DatatypeDecls> => SgnItem::Datatype(dts),
    "structure" <name:"UIDENT"> ":" <s:Sgn> => SgnItem::Str(name, s),
    "signature" <name:"UIDENT"> "=" <s:Sgn> => SgnItem::Sgn(name, s),
    "include" <s:Sgn> => SgnItem::Include(s),
    "constraint" <c1:Con> "~" <c2:Con> => SgnItem::Constraint(c1, c2),
    // `class nm` (bare → Type→Type kind) | `class nm = C` | `class nm :: K` | `class nm :: K = C`
    "class" <name:"IDENT"> "=" <c:Con> =>
        SgnItem::Class(name, Box::new(Located::dummy(Kind::Wild)), c),
    "class" <name:"IDENT"> "::" <k:Kind> => SgnItem::ClassAbs(name, Box::new(k)),
    "class" <name:"IDENT"> "::" <k:Kind> "=" <c:Con> =>
        SgnItem::Class(name, Box::new(k), c),
    "class" <name:"IDENT"> => SgnItem::ClassAbs(name, Box::new(Located::dummy(Kind::Arrow(
        Box::new(Located::dummy(Kind::Type)), Box::new(Located::dummy(Kind::Type)))))),
    "table" <name:"IDENT"> ":" <c:Con> => {
        let z = Located::dummy(Exp::Record(vec![], false));
        SgnItem::Table(name, c, z.clone(), z)
    },
    // Functor declaration in a signature; return sig delimited by `:` (matching Ur/Web grammar)
    "functor" <name:"UIDENT"> "(" <arg:"UIDENT"> ":" <s1:Sgn> ")" ":" <s2:Sgn> =>
        SgnItem::Functor(name, arg, Box::new(s1), Box::new(s2)),
};

// ---------------------------------------------------------------------------
// Kinds
// ---------------------------------------------------------------------------

Kind: LocKind = {
    <l:@L> <k:KindNode> <r:@R> => Located::new(k, Span::from_offsets("", l, r, &[])),
};

KindNode: Kind = {
    <k1:KindApp> "->" <k2:Kind> => Kind::Arrow(Box::new(k1), Box::new(k2)),
    // Kind product: `K1 * K2` (e.g. `{Type} * {Type}`)
    // Right-associative; flatten nested tuples.
    <k1:KindApp> "*" <k2:Kind> => {
        let mut parts = vec![k1];
        match k2.node {
            Kind::Tuple(mut rest) => parts.append(&mut rest),
            other => parts.push(Located::new(other, k2.span)),
        }
        Kind::Tuple(parts)
    },
    <k:KindApp>                 => k.node,
};

KindApp: LocKind = {
    <l:@L> <k:KindAtom> <r:@R> => Located::new(k, Span::from_offsets("", l, r, &[])),
};

KindAtom: Kind = {
    "*"     => Kind::Type,
    // Ur/Web uses uppercase `Type` for the kind of types
    "Type"  => Kind::Type,
    // Ur/Web uses uppercase `Unit` for the kind of unit/constraints
    "Unit"  => Kind::Unit,
    "#" <k:KindAtom> => Kind::Record(Box::new(Located::dummy(k))),
    // `{k}` = row kind (same as # k)
    "{" <k:Kind> "}" => Kind::Record(Box::new(k)),
    // Note: "()" as Kind::Unit is NOT here to avoid LALR conflict with AtomConNode = "()".
    // Use "( )" or just avoid it; basis.urs never uses () as a kind.
    "(" <k:Kind> ")" => k.node,
    "_"     => Kind::Wild,
    <name:"IDENT"> => Kind::Var(name),
    // "Name" is a keyword token (priority 3 over UIDENT); handle it explicitly
    "Name" => Kind::Name,
    // Other UIDENTs become kind vars
    <name:"UIDENT"> => Kind::Var(name),
};

KindAnnot: LocKind = {
    "::" <k:Kind> => k,
};


// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Signature constructors (used in .urs val types)
// Like Con but also allows `name ::: kind ->` and `name :: kind ->` at the top.
// ---------------------------------------------------------------------------

// Same surface as `Con`. `.urs` input is preprocessed (`parse::preprocess_urs`) so leading
// `name :: KindAtom ->` / `name ::: KindAtom ->` become bracketed row quantifiers parseable
// as `Con` — avoiding a second `IDENT ::` / `IDENT :::` start that conflicted with `AtomCon`.
SigCon: LocCon = {
    Con => <>,
};

// Constructors / types
// ---------------------------------------------------------------------------

Con: LocCon = {
    <l:@L> <c:ConNode> <r:@R> => Located::new(c, Span::from_offsets("", l, r, &[])),
};

ConNode: Con = {
    // product/tuple type: `A * B`  →  Tuple([A, B])
    // Right-associative; flattens nested tuples so `A * B * C` = Tuple([A, B, C]).
    <c1:AppCon> "*" <c2:Con> => {
        let mut parts = vec![c1];
        match c2.node {
            Con::Tuple(mut rest) => parts.append(&mut rest),
            other => parts.push(Located::new(other, c2.span)),
        }
        Con::Tuple(parts)
    },

    // function type
    <c1:AppCon> "->" <c2:Con> => Con::TFun(Box::new(c1), Box::new(c2)),

    // constructor-level function type (implicit) — kind annotation required
    // to avoid ambiguity with "[" FieldName "]" row literal
    "[" <name:"IDENT"> "::" <k:Kind> "]" "->" <c:Con> =>
        Con::TCFun(Explicitness::Explicit, name, Box::new(k), Box::new(c)),
    // Same with ::: (implicit / wildcard-style quantifier)
    "[" <name:"IDENT"> ":::" <k:Kind> "]" "->" <c:Con> =>
        Con::TCFun(Explicitness::Implicit, name, Box::new(k), Box::new(c)),



    // disjointness constraint
    "[" <c1:Con> "~" <c2:Con> "]" "=>" <c3:Con> =>
        Con::TDisjoint(Box::new(c1), Box::new(c2), Box::new(c3)),


    // kind abstraction and constructor lambdas; ConFnRest handles remaining args
    "fn" "[" <name:"IDENT"> "]" <rest:ConFnRest> =>
        Con::KAbs(name, rest),
    "fn" "[" <name:"IDENT"> "::" <k:Kind> "]" <rest:ConFnRest> =>
        Con::KAbs(name, rest),
    "fn" <name:"IDENT"> <k:KindAnnot?> <rest:ConFnRest> =>
        Con::Abs(name, k.map(Box::new), rest),
    // wildcard constructor lambda: `fn _ => c` or `fn _ :: K => c`
    "fn" "WILDANNOT" <k:Kind> <rest:ConFnRest> =>
        Con::Abs("_".into(), Some(Box::new(k)), rest),
    "fn" "_" <rest:ConFnRest> =>
        Con::Abs("_".into(), None, rest),
    // multi-param constructor lambda: `fn (a :: K1, b :: K2) => body` (also single `(a :: K)`)
    "fn" "(" <params:ConLamParamList> ")" <rest:ConFnRest> => {
        params.into_iter().rev().fold((*rest).node, |acc_node, (nm, k)| {
            Con::Abs(nm, Some(Box::new(k)), Box::new(Located::dummy(acc_node)))
        })
    },

    // concatenation
    <c1:AppCon> "++" <c2:Con> => Con::Concat(Box::new(c1), Box::new(c2)),

    <c:AppCon> => c.node,
};

// ConFnRest: the tail of a constructor lambda, after the first binder.
// Either `=> Con` (done) or another binder followed by more.
// Returns LocCon because Con::KAbs/Abs take Box<LocCon>.
ConFnRest: Box<LocCon> = {
    "=>" <c:Con> => Box::new(c),
    <l:@L> "[" <name:"IDENT"> "]" <rest:ConFnRest> <r:@R> =>
        Box::new(Located::new(Con::KAbs(name, rest), Span::from_offsets("", l, r, &[]))),
    <l:@L> "[" <name:"IDENT"> "::" <k:Kind> "]" <rest:ConFnRest> <r:@R> =>
        Box::new(Located::new(Con::KAbs(name, rest), Span::from_offsets("", l, r, &[]))),
    <l:@L> <name:"IDENT"> <k:KindAnnot?> <rest:ConFnRest> <r:@R> =>
        Box::new(Located::new(Con::Abs(name, k.map(Box::new), rest), Span::from_offsets("", l, r, &[]))),
    <l:@L> "WILDANNOT" <k:Kind> <rest:ConFnRest> <r:@R> =>
        Box::new(Located::new(Con::Abs("_".into(), Some(Box::new(k)), rest), Span::from_offsets("", l, r, &[]))),
    <l:@L> "_" <rest:ConFnRest> <r:@R> =>
        Box::new(Located::new(Con::Abs("_".into(), None, rest), Span::from_offsets("", l, r, &[]))),
    <l:@L> "(" <params:ConLamParamList> ")" <rest:ConFnRest> <r:@R> => {
        let inner = params.into_iter().rev().fold((*rest).node, |acc_node, (nm, k)| {
            Con::Abs(nm, Some(Box::new(k)), Box::new(Located::dummy(acc_node)))
        });
        Box::new(Located::new(inner, Span::from_offsets("", l, r, &[])))
    },
};

AppCon: LocCon = {
    <l:@L> <c:AppConInner> <r:@R> => Located::new(c, Span::from_offsets("", l, r, &[])),
};

AppConInner: Con = {
    <f:AppCon> <x:DotCon> => Con::App(Box::new(f), Box::new(x)),
    <c:DotCon> => c.node,
};

// DotCon: AtomCon with optional dot-suffix (projection or module qualification).
// All dot-access lives here so dot binds tighter than application:
//   `p.1`   → tuple projection (Con::Proj)
//   `M.foo` → module-qualified var (Con::Var(["M"], "foo"))
// This ensures `f p.1 p.2` parses as `App(App(f, Proj(p,1)), Proj(p,2))`.
DotCon: LocCon = {
    <c:AtomCon> => c,
    <l:@L> <f:DotCon> "." <n:"INT"> <r:@R> =>
        Located::new(Con::Proj(Box::new(f), n as usize), Span::from_offsets("", l, r, &[])),
    <l:@L> <f:DotCon> "." <name:"IDENT"> <r:@R> => {
        Located::new(match f.node.clone() {
            Con::Var(mut quals, last) => { quals.push(last); Con::Var(quals, name) }
            _ => Con::Var(vec![], name)
        }, Span::from_offsets("", l, r, &[]))
    },
    <l:@L> <f:DotCon> "." <name:"UIDENT"> <r:@R> => {
        Located::new(match f.node.clone() {
            Con::Var(mut quals, last) => { quals.push(last); Con::Var(quals, name) }
            _ => Con::Var(vec![], name)
        }, Span::from_offsets("", l, r, &[]))
    },
};

AtomCon: LocCon = {
    <l:@L> <c:AtomConNode> <r:@R> => Located::new(c, Span::from_offsets("", l, r, &[])),
};

AtomConNode: Con = {
    "()" => Con::Unit,
    "_"  => Con::Wild(Box::new(Located::dummy(Kind::Wild))),
    // `$C` — record type from row constructor (syntactic sugar for TRecord(C))
    "$" <c:AtomCon> => Con::TRecord(Box::new(c)),
    // Record type forms — must be at AtomCon level so they can appear left of `->`
    // empty record type: `{}`  →  TRecord (empty row)
    "{" "}" => Con::TRecord(Box::new(Located::dummy(Con::Record(vec![])))),
    // named record type: `{nm : T, ...}` — sugar for `$[nm = T, ...]`
    "{" <fields:TypeRecordFields> "}" => {
        let row: Vec<(LocCon, LocCon)> = fields.into_iter()
            .map(|(nm, typ)| (Located::dummy(Con::Name(nm)), typ))
            .collect();
        Con::TRecord(Box::new(Located::dummy(Con::Record(row))))
    },
    // record type from a row expression: `{C}`
    "{" <c:Con> "}" => Con::TRecord(Box::new(c)),
    "#" <name:"IDENT"> => Con::Name(name),
    "#" <name:"UIDENT"> => Con::Name(name),
    "map" => Con::Map,
    // Simple identifiers (no dots — dots are handled in AppConInner above)
    <name:"IDENT">  => Con::Var(vec![], name),
    <name:"UIDENT"> => Con::Var(vec![], name),
    // Empty row: []
    "[" "]" => Con::Record(vec![]),
    // Non-empty row literal: `[nm = T, ...]` or punned `[nm, ...]`
    "[" <fields:ConFieldList> "]" => Con::Record(fields),
    // Parenthesised constructors — use ConInParen to isolate the `_ ::` case
    // from the general `_` reduction state (avoids LALR state merge dropping
    // the `::` shift).
    "(" <c:ConInParen> ")" => c,
};

// Constructor content inside parentheses.
// Using a dedicated non-terminal ensures that the LR state "after `(` then `_`"
// has a distinct core from the general "after `_`" state, so the `_ :: KindApp`
// shift is not dropped by LALR state merging.
ConInParen: Con = {
    // kind-annotated wildcard: `(_ :: K)`
    "WILDANNOT" <k:Kind> => Con::Wild(Box::new(k)),
    // annotated constructor: `(C : K)`
    <c:Con> ":" <k:Kind> => Con::Annot(Box::new(c), Box::new(k)),
    // tuple: `(C, D, ...)`
    <cs:ConList2> => Con::Tuple(cs),
    // plain parenthesised constructor: `(C)`
    <c:Con> => c.node,
};

ConList2: Vec<LocCon> = {
    <c1:Con> "," <c2:Con> => vec![c1, c2],
    <cs:ConList2> "," <c:Con> => { let mut v = cs; v.push(c); v },
};

/// A single `nm :: K` or `nm ::: K` binder for multi-param con lambda.
ConLamParam: (String, LocKind) = {
    <nm:"IDENT"> "::" <k:Kind> => (nm, k),
    <nm:"IDENT"> ":::" <k:Kind> => (nm, k),
};

/// Comma-separated con lambda params: `(a :: K1, b :: K2, ...)` — left-recursive list
/// (no nullable comma tail) for LALR.
ConLamParamList: Vec<(String, LocKind)> = {
    <p:ConLamParam> => vec![p],
    <ps:ConLamParamList> "," <p:ConLamParam> => { let mut v = ps; v.push(p); v },
};

// Non-empty comma-separated list of constructor record fields (no empty alternative).
// Using AtomCon (not bare IDENT) for the field name ensures the LR(1) state after
// `[` `IDENT` has {=, ], ,} as the follow set for the IDENT reduction — keeping `::` and
// `:::` exclusively as shift actions for `[nm :: K] -> Con` / `[nm ::: K] -> Con`.
ConFieldList: Vec<(LocCon, LocCon)> = {
    <f:ConField> => vec![f],
    <fs:ConFieldList> "," <f:ConField> => { let mut v = fs; v.push(f); v },
};

ConField: (LocCon, LocCon) = {
    <name:AtomCon> "=" <c:Con> => (name, c),
    <name:AtomCon> => con_record_field_pun(name),
};

/// Named record type fields: `nm : T, ...` (uses `:` not `=`)
/// Used in `{nm : T}` record-type syntax.
TypeRecordFields: Vec<(String, LocCon)> = {
    <nm:TypeRecordFieldName> ":" <c:Con> => vec![(nm, c)],
    <rest:TypeRecordFields> "," <nm:TypeRecordFieldName> ":" <c:Con> => {
        let mut v = rest; v.push((nm, c)); v
    },
};

TypeRecordFieldName: String = {
    <name:"IDENT">  => name,
    <name:"UIDENT"> => name,
    "Name" => "Name".to_string(),
};

// ---------------------------------------------------------------------------
// Patterns
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Pattern grammar
//
// Constructor patterns with arguments must be parenthesized: (Con arg).
// This avoids the LR(1) ambiguity in both function argument lists and case
// arms. The "Pat" level handles type annotation.
// ---------------------------------------------------------------------------

// LangSec: LR(1)-clean pattern grammar (no #[precedence] needed — context-sensitive
// lookaheads resolve all ambiguities automatically in full LR(1) mode).
//
// Design:
//  - Constructor application `Con atpat` lives in PatNode (NOT in AtomPat)
//  - List cons `atpat :: pat` lives in PatNode; tail recurses on Pat for right-assoc
//  - Bare constructors live in AtomPatNode — LR(1) keeps them in separate states from
//    PatNode's `UpperPath AtomPat` context, so no shift/reduce conflict arises
//  - Annotation uses `AtomPat ":" Con` (no `Pat ":" Con`) to avoid `h::t : T` ambiguity
Pat: LocPat = {
    <l:@L> <p:PatNode> <r:@R> => Located::new(p, Span::from_offsets("", l, r, &[])),
};

PatNode: Pat = {
    // Type annotation on an atomic pattern: p : T
    <l:@L> <p:AtomPat> ":" <c:Con> <r:@R> =>
        Pat::Annot(Box::new(p), c),
    // Constructor application: Con atpat
    // At PatNode level (not in AtomPat) so that the UpperPath in function-arg
    // lists (AtomPat+) stays in a separate LR(1) state from the constructor-app rule.
    <path:UpperPath> <inner:AtomPat> => {
        let mut v = path;
        let last = v.pop().unwrap_or_default();
        Pat::Con(v, last, Some(Box::new(inner)))
    },
    // List cons: atpat :: pat — right-associative via recursion on Pat.
    // LR(1): after AtomPat, seeing "::" is unambiguous because "::" ∉ FOLLOW(PatNode).
    // Bare `Foo :: rest` works via AtomPatNode = UpperPath → AtomPat, then this rule.
    <l:@L> <h:AtomPat> "::" <t:Pat> <r:@R> => {
        let pair = Located::new(
            Pat::Record(vec![("1".into(), h), ("2".into(), t)], false),
            Span::from_offsets("", l, r, &[]),
        );
        Pat::Con(vec![], "Cons".into(), Some(Box::new(pair)))
    },
    // Pass-through
    <p:AtomPat> => p.node,
};

AtomPat: LocPat = {
    <l:@L> <p:AtomPatNode> <r:@R> => Located::new(p, Span::from_offsets("", l, r, &[])),
};

AtomPatNode: Pat = {
    // Unit pattern: `()`
    "()" => Pat::Record(vec![], false),
    "_" => Pat::Var("_".into()),
    <name:"IDENT"> => Pat::Var(name),
    <n:"INT"> => Pat::Prim(crate::primitives::Prim::Int(n)),
    <f:"FLOAT"> => Pat::Prim(crate::primitives::Prim::Float(f)),
    <s:"STRING"> => Pat::Prim(crate::primitives::Prim::String(crate::primitives::StringMode::Normal, s)),
    <ch:"CHAR"> => Pat::Prim(crate::primitives::Prim::Char(ch)),
    "true"  => Pat::Prim(crate::primitives::Prim::Int(1)),
    "false" => Pat::Prim(crate::primitives::Prim::Int(0)),
    // Bare constructor without argument. LR(1) keeps this in a separate state from
    // `PatNode = UpperPath AtomPat` when UpperPath appears in function-arg (AtomPat+)
    // context, so no shift/reduce conflict arises.
    <path:UpperPath> => {
        let mut v = path;
        let last = v.pop().unwrap_or_default();
        Pat::Con(v, last, None)
    },
    // Nil pattern: `[]`
    "[" "]" => Pat::Con(vec![], "Nil".into(), None),
    // Record pattern — explicit empty/nonempty/open cases to avoid nullable conflict
    "{" "}" =>
        Pat::Record(vec![], false),
    "{" "..." "}" =>
        Pat::Record(vec![], true),
    "{" <fields:PatFieldList> "}" =>
        Pat::Record(fields, false),
    "{" <fields:PatFieldList> "," "..." "}" =>
        Pat::Record(fields, true),
    // Parenthesized pattern: also handles constructor-with-arg: (Some x), etc.
    "(" <p:Pat> ")" => p.node,
};

// Non-empty comma-separated list of pattern fields
PatFieldList: Vec<(String, LocPat)> = {
    <f:PatField> => vec![f],
    <fs:PatFieldList> "," <f:PatField> => { let mut v = fs; v.push(f); v },
};

PatField: (String, LocPat) = {
    <name:FieldName> "=" <p:Pat> => (name, p),
    <name:"IDENT"> => {
        let l = Located::dummy(Pat::Var(name.clone()));
        (name, l)
    },
    <name:"UIDENT"> => {
        let l = Located::dummy(Pat::Con(vec![], name.clone(), None));
        (name, l)
    },
};

// ---------------------------------------------------------------------------
// Expressions
//
// LangSec (https://langsec.org/): valid input should be a formal language and
// the parser a single recognizer for it—no ambiguous tables, no scattered
// “shotgun” disambiguation. The application / type-app / dot-postfix tier follows
// ML `eapps` in `src/urweb.grm`: **left-recursive** juxtaposition is `AppExp` (`AtomExp` /
// `PostfixOp`); `MulExp` is `AppExp` plus left-recursive `*` `/` `%` on `AppExp` operands only.
// `expr_langsec::parse_cmp_app_spine` remains the reference recognizer for that tier.
//
// Precedence levels (low to high):
//   Exp       — sequencing (e1 ; e2), right-associative
//   NonSeqExp — `BoolExp` + right-factored andalso/orelse tail (left-associative fold)
//   BoolExp   — type annotation, fn, if, case, let
//   CmpExp … MulExp — comparisons, add, mul (left-associative)
//   AppExp — juxtaposition, `[Con]` CApp, `.` projections (see `urweb.grm` `eapps`)
//   AtomExp   — atomic (literals, identifiers, records, parens)
//
// The split between Exp and NonSeqExp is critical: declarations use NonSeqExp
// so that the greedy ";" does not create shift/reduce conflicts at the
// declaration boundary (Decl*).
// ---------------------------------------------------------------------------

// Full expression including sequencing (used inside let/case/parens)
Exp: LocExp = {
    <l:@L> <e:ExpNode> <r:@R> => Located::new(e, Span::from_offsets("", l, r, &[])),
};

ExpNode: Exp = {
    // Lambda — body is full Exp (greedy right extension, avoids dangling-fn ambiguity
    // by keeping fn out of NonSeqExp so the left of `;` is always NonSeqExp).
    "fn" <params:FnLamParams> "=>" <e:Exp> =>
        wrap_fun_params(params, e).node,
    // Monadic bind: `x <- e1; e2`  (also `_ <- e1; e2`)
    <name:"IDENT"> "<-" <e1:NonSeqExp> ";" <e2:Exp> =>
        Exp::Let(vec![Located::dummy(EDecl::Val(Located::dummy(Pat::Var(name)), e1))], Box::new(e2)),
    "_" "<-" <e1:NonSeqExp> ";" <e2:Exp> =>
        Exp::Let(vec![Located::dummy(EDecl::Val(Located::dummy(Pat::Var("_".into())), e1))], Box::new(e2)),
    // Sequencing — right-associative via NonSeqExp on left, Exp on right
    <e1:NonSeqExp> ";" <e2:Exp> =>
        Exp::Let(vec![Located::dummy(EDecl::Val(Located::dummy(Pat::Var("_".into())), e1))], Box::new(e2)),
    <e:NonSeqExp> => e.node,
};

// Non-sequencing expression — left-recursive andalso/orelse (LangSec: one algorithm,
// no nullable tails that produce shift/reduce conflicts).
NonSeqExp: LocExp = {
    <l:@L> <e:NonSeqExpNode> <r:@R> => Located::new(e, Span::from_offsets("", l, r, &[])),
};

NonSeqExpNode: Exp = {
    <e1:NonSeqExp> "andalso" <e2:BoolExp> => Exp::Case(Box::new(e1), vec![
        (Located::dummy(Pat::Con(vec!["Basis".into()], "True".into(), None)), e2),
        (Located::dummy(Pat::Con(vec!["Basis".into()], "False".into(), None)),
         Located::dummy(Exp::Var(vec!["Basis".into()], "False".into(), Inference::DontInfer))),
    ]),
    <e1:NonSeqExp> "orelse" <e2:BoolExp> => Exp::Case(Box::new(e1), vec![
        (Located::dummy(Pat::Con(vec!["Basis".into()], "True".into(), None)),
         Located::dummy(Exp::Var(vec!["Basis".into()], "True".into(), Inference::DontInfer))),
        (Located::dummy(Pat::Con(vec!["Basis".into()], "False".into(), None)), e2),
    ]),
    <e:BoolExp> => e.node,
};

// Boolean/annotation level — fn, if, case, let, type annotation
BoolExp: LocExp = {
    <l:@L> <e:BoolExpNode> <r:@R> => Located::new(e, Span::from_offsets("", l, r, &[])),
};

BoolExpNode: Exp = {
    // Keyword expressions — no conflict with ArithExp (different FIRST sets).
    #[precedence(level="0")]
    "if" <cond:NonSeqExp> "then" <t:BoolExp> "else" <f:BoolExp> =>
        Exp::Case(Box::new(cond), vec![
            (Located::dummy(Pat::Con(vec!["Basis".into()], "True".into(), None)), t),
            (Located::dummy(Pat::Con(vec!["Basis".into()], "False".into(), None)), f),
        ]),

    // case — two prefixes so `case_bar` / first `Pat` are disjoint (no nullable `CaseBarOpt`).
    #[precedence(level="0")]
    "case" <e:NonSeqExp> "of" "case_bar" <first:CaseArm> <more:CalTail> => {
        let mut arms = vec![first];
        arms.extend(more);
        Exp::Case(Box::new(e), arms)
    },
    #[precedence(level="0")]
    "case" <e:NonSeqExp> "of" <first:CaseArm> <more:CalTail> => {
        let mut arms = vec![first];
        arms.extend(more);
        Exp::Case(Box::new(e), arms)
    },

    // let — body uses full Exp to allow sequencing
    #[precedence(level="0")]
    "let" <decls:EDecl*> "in" <e:Exp> "end" =>
        Exp::Let(decls, Box::new(e)),

    // Type annotation: prefer shift (`:`) over pass-through reduce.
    // LangSec: `#[precedence]` is the formal disambiguation — no implicit yacc defaults.
    #[precedence(level="2")]
    <e:ArithExp> ":" <c:Con> => Exp::Annot(Box::new(e), c),

    // Pass-through — lower precedence so `:` forces the annotation rule above.
    #[precedence(level="1")]
    <e:ArithExp> => e.node,
};

// ---------------------------------------------------------------------------
// Arithmetic expression levels
// ---------------------------------------------------------------------------
//
// LangSec: one flat `ArithExp` non-terminal with `#[precedence]` annotations
// is the single, total, unambiguous recognizer for the operator/application
// spine — exactly mirroring `expr_langsec::parse_cmp_app_spine`.
//
// Precedence levels (higher number = tighter binding):
//   1 — atoms (base case, no operator)
//   2 — application: juxtaposition + `[Con]` CApp + `.` projections
//   3 — `*`, `/`, `%`
//   4 — `+`, `-`, `^`; `::` is right-associative at the same level
//   5 — `=`, `<>`, `<`, `>`, `<=`, `>=` (loosest)
//
// `AppExp` is kept as a *separate*, application-only non-terminal used exclusively
// in the `task` rule where `=` must terminate the trigger without ambiguity.
// Because `AppExp` appears only in that context (follow set = {"="}), which is
// disjoint from FIRST(AtomExp), no shift/reduce conflict arises for `AppExp`.

PostfixOp: crate::parse::expr_langsec::ExpPostfixOp = {
    "[" <c:Con> "]" => crate::parse::expr_langsec::ExpPostfixOp::CApp(c),
    "." <name:"IDENT"> => crate::parse::expr_langsec::ExpPostfixOp::DotIdent(name),
    "." "#" <name:"IDENT"> => crate::parse::expr_langsec::ExpPostfixOp::DotHash(name),
    "." <name:"UIDENT"> => crate::parse::expr_langsec::ExpPostfixOp::DotUident(name),
};

// Application-only expressions — used exclusively in `task` to prevent `=` ambiguity.
AppExp: LocExp = {
    <a:AtomExp> => a,
    <l:@L> <e:AppExp> <t:AtomExp> <r:@R> => Located::new(
        Exp::App(Box::new(e), Box::new(t)),
        Span::from_offsets("", l, r, &[])),
    <l:@L> <e:AppExp> <op:PostfixOp> <r:@R> =>
        crate::parse::expr_langsec::fold_postfixes(e, vec![op], "", l, r, &[]),
};

// Full arithmetic + application spine — single flat recognizer, conflict-free via `#[precedence]`.
ArithExp: LocExp = {
    // Atoms — base case (level 1)
    #[precedence(level="1")]
    <a:AtomExp> => a,

    // Application and postfixes (level 2 — tighter than all operators)
    #[precedence(level="2")] #[assoc(side="left")]
    <l:@L> <e:ArithExp> <t:AtomExp> <r:@R> => Located::new(
        Exp::App(Box::new(e), Box::new(t)),
        Span::from_offsets("", l, r, &[])),
    #[precedence(level="2")] #[assoc(side="left")]
    <l:@L> <e:ArithExp> <op:PostfixOp> <r:@R> =>
        crate::parse::expr_langsec::fold_postfixes(e, vec![op], "", l, r, &[]),

    // Multiplicative operators (level 3)
    #[precedence(level="3")] #[assoc(side="left")]
    <l:@L> <e1:ArithExp> "*" <e2:ArithExp> <r:@R> => Located::new(
        Exp::Infix("*".into(), Box::new(e1), Box::new(e2)),
        Span::from_offsets("", l, r, &[])),
    #[precedence(level="3")] #[assoc(side="left")]
    <l:@L> <e1:ArithExp> "/" <e2:ArithExp> <r:@R> => Located::new(
        Exp::Infix("/".into(), Box::new(e1), Box::new(e2)),
        Span::from_offsets("", l, r, &[])),
    #[precedence(level="3")] #[assoc(side="left")]
    <l:@L> <e1:ArithExp> "%" <e2:ArithExp> <r:@R> => Located::new(
        Exp::Infix("%".into(), Box::new(e1), Box::new(e2)),
        Span::from_offsets("", l, r, &[])),

    // Additive operators (level 4)
    #[precedence(level="4")] #[assoc(side="left")]
    <l:@L> <e1:ArithExp> "+" <e2:ArithExp> <r:@R> => Located::new(
        Exp::Infix("+".into(), Box::new(e1), Box::new(e2)),
        Span::from_offsets("", l, r, &[])),
    #[precedence(level="4")] #[assoc(side="left")]
    <l:@L> <e1:ArithExp> "-" <e2:ArithExp> <r:@R> => Located::new(
        Exp::Infix("-".into(), Box::new(e1), Box::new(e2)),
        Span::from_offsets("", l, r, &[])),
    // `^` is Ur/Web string-concatenation: desugar to `Basis.strcat e1 e2`
    #[precedence(level="4")] #[assoc(side="left")]
    <l:@L> <e1:ArithExp> "^" <e2:ArithExp> <r:@R> => {
        let pos = Span::from_offsets("", l, r, &[]);
        let strcat = Located::new(
            Exp::Var(vec!["Basis".into()], "strcat".into(), Inference::DontInfer),
            pos.clone(),
        );
        let app1 = Located::new(Exp::App(Box::new(strcat), Box::new(e1)), pos.clone());
        Located::new(Exp::App(Box::new(app1), Box::new(e2)), pos)
    },
    // `::` is right-associative (cons): `a :: b :: c` = `a :: (b :: c)`
    // Level 5 — looser than additive (+/-/^) but tighter than comparison
    #[precedence(level="5")] #[assoc(side="right")]
    <l:@L> <e1:ArithExp> "::" <e2:ArithExp> <r:@R> => Located::new(
        Exp::Infix("::".into(), Box::new(e1), Box::new(e2)),
        Span::from_offsets("", l, r, &[])),

    // Comparison operators (level 6 — loosest)
    #[precedence(level="6")] #[assoc(side="left")]
    <l:@L> <e1:ArithExp> "=" <e2:ArithExp> <r:@R> => Located::new(
        Exp::Infix("=".into(), Box::new(e1), Box::new(e2)),
        Span::from_offsets("", l, r, &[])),
    #[precedence(level="6")] #[assoc(side="left")]
    <l:@L> <e1:ArithExp> "<>" <e2:ArithExp> <r:@R> => Located::new(
        Exp::Infix("<>".into(), Box::new(e1), Box::new(e2)),
        Span::from_offsets("", l, r, &[])),
    #[precedence(level="6")] #[assoc(side="left")]
    <l:@L> <e1:ArithExp> "<" <e2:ArithExp> <r:@R> => Located::new(
        Exp::Infix("<".into(), Box::new(e1), Box::new(e2)),
        Span::from_offsets("", l, r, &[])),
    #[precedence(level="6")] #[assoc(side="left")]
    <l:@L> <e1:ArithExp> ">" <e2:ArithExp> <r:@R> => Located::new(
        Exp::Infix(">".into(), Box::new(e1), Box::new(e2)),
        Span::from_offsets("", l, r, &[])),
    #[precedence(level="6")] #[assoc(side="left")]
    <l:@L> <e1:ArithExp> "<=" <e2:ArithExp> <r:@R> => Located::new(
        Exp::Infix("<=".into(), Box::new(e1), Box::new(e2)),
        Span::from_offsets("", l, r, &[])),
    #[precedence(level="6")] #[assoc(side="left")]
    <l:@L> <e1:ArithExp> ">=" <e2:ArithExp> <r:@R> => Located::new(
        Exp::Infix(">=".into(), Box::new(e1), Box::new(e2)),
        Span::from_offsets("", l, r, &[])),
};

// Table `where` policies are not in the LR(1) surface grammar here (would share a `Con`·`where`
// boundary with `AppSgn`); the reference compiler supports them via a distinct parse path.

AtomExp: LocExp = {
    <l:@L> <e:AtomExpNode> <r:@R> => Located::new(e, Span::from_offsets("", l, r, &[])),
};

// ---------------------------------------------------------------------------
// Lambda / function parameter lists
// ---------------------------------------------------------------------------

/// One parameter in a fn/fun binding: a term pattern or a constructor-level arg.
FnLamParam: FunParam = {
    <p:AtomPat> => FunParam::Term(p),
    // Implicit constructor variable (kind inferred): [nm]
    "[" <nm:"IDENT"> "]" => FunParam::ConArg(Explicitness::Implicit, nm, None),
    // Explicit constructor variable with kind: [nm :: K]
    "[" <nm:"IDENT"> "::" <k:Kind> "]" => FunParam::ConArg(Explicitness::Explicit, nm, Some(k)),
    // Row/implicit constructor variable: [nm ::: K]
    "[" <nm:"IDENT"> ":::" <k:Kind> "]" => FunParam::ConArg(Explicitness::Implicit, nm, Some(k)),
    // Wildcard implicit: [_ :: K]  (WILDANNOT inside brackets)
    "[" "WILDANNOT" <k:Kind> "]" => FunParam::ConArg(Explicitness::Implicit, "_".into(), Some(k)),
    // Disjointness constraint: [[c1] ~ rest]
    "[" <c1:Con> "~" <c2:Con> "]" => FunParam::Disjoint(c1, c2),
};

/// One or more lambda/fun parameters.
FnLamParams: Vec<FunParam> = {
    <p:FnLamParam> => vec![p],
    <ps:FnLamParams> <p:FnLamParam> => { let mut v = ps; v.push(p); v },
};

AtomExpNode: Exp = {
    // Unit literal: `()` → empty record
    "()" => Exp::Record(vec![], false),
    // Explicit application: @e applies e's next implicit argument explicitly
    "@" <e:AtomExp> => Exp::DisjointApp(Box::new(e)),
    <n:"INT">    => Exp::Prim(crate::primitives::Prim::Int(n)),
    <f:"FLOAT">  => Exp::Prim(crate::primitives::Prim::Float(f)),
    <s:"STRING"> => Exp::Prim(crate::primitives::Prim::String(crate::primitives::StringMode::Normal, s)),
    <ch:"CHAR">  => Exp::Prim(crate::primitives::Prim::Char(ch)),
    "true"  => Exp::Var(vec!["Basis".into()], "True".into(), Inference::DontInfer),
    "false" => Exp::Var(vec!["Basis".into()], "False".into(), Inference::DontInfer),
    // Simple identifier (no dots — dots handled in PostfixOp)
    <name:"IDENT">  => Exp::Var(vec![], name, Inference::DontInfer),
    <name:"UIDENT"> => Exp::Var(vec![], name, Inference::DontInfer),
    // Record expressions — explicit empty and non-empty cases to avoid
    // nullable ExpFields conflict
    "{" "}" => Exp::Record(vec![], false),
    "{" "..." "}" => Exp::Record(vec![], true),
    "{" <fields:ExpFieldList> "}" => Exp::Record(fields, false),
    "{" <fields:ExpFieldList> "," "..." "}" => Exp::Record(fields, true),
    // Parenthesized expression — uses full Exp to allow sequencing
    "(" <e:Exp> ")" => e.node,
    "_" => Exp::Wild,
    "___" => Exp::Hole,
    // XML outer wrapper: <xml> content </xml>
    // The lexer produces BeginTag("xml") from Regular mode, enters Xml mode,
    // then EndTag("xml") exits back to Regular mode.
    <l:@L> "BEGIN_TAG" "END_TAG" <r:@R> => {
        let pos = Span::from_offsets("", l, r, &[]);
        xml_empty_cdata(pos).node
    },
    <l:@L> "BEGIN_TAG" <xml:Xml> "END_TAG" <r:@R> => xml.node,
    // <xml/>  — empty XML fragment
    <l:@L> "XML_BEGIN_END" <r:@R> => {
        let pos = Span::from_offsets("", l, r, &[]);
        xml_empty_cdata(pos).node
    },
};

// Non-empty comma-separated list of expression fields
ExpFieldList: Vec<(LocCon, LocExp)> = {
    <f:ExpField> => vec![f],
    <fs:ExpFieldList> "," <f:ExpField> => { let mut v = fs; v.push(f); v },
};

// ---------------------------------------------------------------------------
// XML rules
// ---------------------------------------------------------------------------

// One or more XML items, right-associated via Basis.join.
Xml: LocExp = {
    <l:@L> <a:XmlOne> <b:Xml> <r:@R> => {
        let pos = Span::from_offsets("", l, r, &[]);
        Located::new(
            Exp::App(
                Box::new(Located::new(
                    Exp::App(
                        Box::new(Located::new(
                            Exp::Var(vec!["Basis".into()], "join".into(), Inference::Infer),
                            pos.clone(),
                        )),
                        Box::new(a),
                    ),
                    pos.clone(),
                )),
                Box::new(b),
            ),
            pos,
        )
    },
    <a:XmlOne> => a,
};

// A single XML item: text, expression splice, or a tag.
XmlOne: LocExp = {
    // Text content → Basis.cdata (Html text)
    <l:@L> <s:"NOTAGS"> <r:@R> => {
        let pos = Span::from_offsets("", l, r, &[]);
        Located::new(
            Exp::App(
                Box::new(Located::new(
                    Exp::Var(vec!["Basis".into()], "cdata".into(), Inference::Infer),
                    pos.clone(),
                )),
                Box::new(Located::new(
                    Exp::Prim(crate::primitives::Prim::String(
                        crate::primitives::StringMode::Html, s,
                    )),
                    pos.clone(),
                )),
            ),
            pos,
        )
    },
    // { exp } — expression splice: the expression provides an XML value
    "{" <e:Exp> "}" => e,
    // { [exp] } — text splice: Top.txt exp
    <l:@L> "{" "[" <e:Exp> "]" "}" <r:@R> => {
        let pos = Span::from_offsets("", l, r, &[]);
        Located::new(
            Exp::App(
                Box::new(Located::new(
                    Exp::Var(vec!["Top".into()], "txt".into(), Inference::Infer),
                    pos.clone(),
                )),
                Box::new(e),
            ),
            pos,
        )
    },
    // Tags: inline `TagHead` … `>` so we never reduce a tag expr before seeing `>` / `/>`
    // (avoids shift/reduce vs another `XmlAttr` on the same lookahead).
    <l:@L> <head:TagHead> "/" ">" <r:@R> => {
        let pos = Span::from_offsets("", l, r, &[]);
        let tag = xml_desugar_tag_open(l, r, head, (None, None, None, None, vec![]));
        let cdata = xml_empty_cdata(pos.clone());
        Located::new(Exp::App(Box::new(tag), Box::new(cdata)), pos)
    },
    <l:@L> <head:TagHead> <attrs:XmlAttrPlus> "/" ">" <r:@R> => {
        let pos = Span::from_offsets("", l, r, &[]);
        let tag = xml_desugar_tag_open(l, r, head, attrs);
        let cdata = xml_empty_cdata(pos.clone());
        Located::new(Exp::App(Box::new(tag), Box::new(cdata)), pos)
    },
    <l:@L> <head:TagHead> ">" "END_TAG" <r:@R> => {
        let pos = Span::from_offsets("", l, r, &[]);
        let tag = xml_desugar_tag_open(l, r, head, (None, None, None, None, vec![]));
        let empty = xml_empty_cdata(pos.clone());
        Located::new(Exp::App(Box::new(tag), Box::new(empty)), pos)
    },
    <l:@L> <head:TagHead> <attrs:XmlAttrPlus> ">" "END_TAG" <r:@R> => {
        let pos = Span::from_offsets("", l, r, &[]);
        let tag = xml_desugar_tag_open(l, r, head, attrs);
        let empty = xml_empty_cdata(pos.clone());
        Located::new(Exp::App(Box::new(tag), Box::new(empty)), pos)
    },
    <l:@L> <head:TagHead> ">" <xml:Xml> "END_TAG" <r:@R> => {
        let pos = Span::from_offsets("", l, r, &[]);
        let tag = xml_desugar_tag_open(l, r, head, (None, None, None, None, vec![]));
        Located::new(Exp::App(Box::new(tag), Box::new(xml)), pos)
    },
    <l:@L> <head:TagHead> <attrs:XmlAttrPlus> ">" <xml:Xml> "END_TAG" <r:@R> => {
        let pos = Span::from_offsets("", l, r, &[]);
        let tag = xml_desugar_tag_open(l, r, head, attrs);
        Located::new(Exp::App(Box::new(tag), Box::new(xml)), pos)
    },
};

// Tag head: (name, exp) where exp starts as EVar(name) and may be extended
// with ECApp(exp, con) for each {con} suffix.
TagHead: (String, LocExp) = {
    <l:@L> <name:"BEGIN_TAG"> <r:@R> => {
        let pos = Span::from_offsets("", l, r, &[]);
        let exp = Located::new(Exp::Var(vec![], name.clone(), Inference::Infer), pos);
        (name, exp)
    },
    <l:@L> <head:TagHead> "{" <c:Con> "}" <r:@R> => {
        let (name, head_exp) = head;
        let pos = Span::from_offsets("", l, r, &[]);
        let new_exp = Located::new(Exp::CApp(Box::new(head_exp), c), pos);
        (name, new_exp)
    },
};

XmlAttrPlus: XmlAttrsAcc = {
    <a:XmlAttr> => xml_attrs_push((None, None, None, None, vec![]), a),
    <rest:XmlAttrPlus> <a:XmlAttr> => xml_attrs_push(rest, a),
};

// Lexer emits `XML_ATTR_NAME_EQ` vs `XML_ATTR_NAME_BARE` after 1-token disambiguation in XmlTag.
XmlAttr: XmlAttr = {
    <name:"XML_ATTR_NAME_EQ"> "=" <v:AttrV> => {
        let cap = capitalize_attr(&name);
        match name.as_str() {
            "class"    => XmlAttr::Class(v),
            "dynClass" => XmlAttr::DynClass(v),
            "style"    => XmlAttr::Style(v),
            "dynStyle" => XmlAttr::DynStyle(v),
            _ => XmlAttr::Normal(Located::dummy(Con::Name(cap)), v),
        }
    },
    <l:@L> <name:"XML_ATTR_NAME_BARE"> <r:@R> => {
        let pos = Span::from_offsets("", l, r, &[]);
        let cap = capitalize_attr(&name);
        let true_exp = Located::new(
            Exp::Var(vec!["Basis".into()], "True".into(), Inference::Infer),
            pos,
        );
        XmlAttr::Normal(Located::dummy(Con::Name(cap)), true_exp)
    },
};

// Attribute value.
AttrV: LocExp = {
    <l:@L> <n:"INT"> <r:@R> => Located::new(
        Exp::Prim(crate::primitives::Prim::Int(n)),
        Span::from_offsets("", l, r, &[]),
    ),
    <l:@L> <f:"FLOAT"> <r:@R> => Located::new(
        Exp::Prim(crate::primitives::Prim::Float(f)),
        Span::from_offsets("", l, r, &[]),
    ),
    <l:@L> <s:"STRING"> <r:@R> => Located::new(
        Exp::Prim(crate::primitives::Prim::String(crate::primitives::StringMode::Normal, s)),
        Span::from_offsets("", l, r, &[]),
    ),
    "{" <e:Exp> "}" => e,
};

ExpField: (LocCon, LocExp) = {
    <name:FieldName> "=" <e:Exp> => (Located::dummy(Con::Name(name)), e),
    <name:"IDENT"> => {
        // Punning: {x} means {x = x}
        let e = Located::dummy(Exp::Var(vec![], name.clone(), Inference::DontInfer));
        (Located::dummy(Con::Name(name)), e)
    },
    // Uppercase pun: {X} means {X = X}
    <name:"UIDENT"> => {
        let e = Located::dummy(Exp::Var(vec![], name.clone(), Inference::DontInfer));
        (Located::dummy(Con::Name(name)), e)
    },
};

/// Field name: lower or upper identifier, or certain keywords used as field names.
FieldName: String = {
    <name:"IDENT"> => name,
    <name:"UIDENT"> => name,
    "Name" => "Name".to_string(),
};

// Remaining arms after the first — no nullable alternative; `case_end` / `arm_sep` are disjoint.
CalTail: Vec<(LocPat, LocExp)> = {
    "case_end" => vec![],
    "arm_sep" <a:CaseArm> <rest:CalTail> => { let mut v = vec![a]; v.extend(rest); v },
};

// Case arm body uses full Exp — safe because arms are delimited by arm_sep/case_end
// pseudo-tokens (not in any Exp rule), so Exp reduces before consuming them.
CaseArm: (LocPat, LocExp) = {
    <p:Pat> "=>" <e:Exp> => (p, e),
};

// BoolExp without top-level "case" and "fn" — used as case arm body to avoid
// the dangling-case shift/reduce conflict on "|".
// "if" and "let" are allowed because they have unambiguous terminators
// ("else" and "end" respectively).
NonCaseBoolExp: LocExp = {
    <l:@L> <e:NonCaseBoolExpNode> <r:@R> => Located::new(e, Span::from_offsets("", l, r, &[])),
};

NonCaseBoolExpNode: Exp = {
    // No `ArithExp : Con` here: use `(e : t)` via `AtomExp` / full `Exp` if you need an
    // annotation in a case arm. No `fn` here either — fn is now only in ExpNode.

    // if-then-else
    #[precedence(level="0")]
    "if" <cond:NonSeqExp> "then" <t:BoolExp> "else" <f:NonCaseBoolExp> =>
        Exp::Case(Box::new(cond), vec![
            (Located::dummy(Pat::Con(vec!["Basis".into()], "True".into(), None)), t),
            (Located::dummy(Pat::Con(vec!["Basis".into()], "False".into(), None)), f),
        ]),

    // let — unambiguous because terminated by "end"
    #[precedence(level="0")]
    "let" <decls:EDecl*> "in" <e:Exp> "end" =>
        Exp::Let(decls, Box::new(e)),

    #[precedence(level="1")]
    <e:ArithExp> => e.node,
};

// Local declarations inside let
EDecl: LocEDecl = {
    <l:@L> <d:EDeclNode> <r:@R> => Located::new(d, Span::from_offsets("", l, r, &[])),
};

EDeclNode: EDecl = {
    "val" <p:Pat> "=" <e:NonSeqExp> => EDecl::Val(p, e),
    "val" "rec" <binds:ValRecBindings> => EDecl::ValRec(binds),
    "fun" <binds:FunBindings> => EDecl::ValRec(binds),
};

// ---------------------------------------------------------------------------
// Shared helpers
// ---------------------------------------------------------------------------

// A dot-separated path of identifiers: `A.B.c`
// Used in open declarations and Sgn.where; NOT used inside expressions.
ModPath: Vec<String> = {
    <name:"IDENT">  => vec![name],
    <name:"UIDENT"> => vec![name],
    <path:ModPath> "." <id:"IDENT">  => { let mut v = path; v.push(id); v },
    <path:ModPath> "." <id:"UIDENT"> => { let mut v = path; v.push(id); v },
};

UpperPath: Vec<String> = {
    <name:"UIDENT"> => vec![name],
    <path:UpperPath> "." <id:"UIDENT"> => { let mut v = path; v.push(id); v },
};

SgnAnnot: LocSgn = {
    ":" <s:Sgn> => s,
};

FfiModes: Vec<FfiMode> = {
    => vec![],
    <modes:FfiModes> <m:FfiMode> => { let mut v = modes; v.push(m); v },
};

FfiMode: FfiMode = {
    <s:"IDENT"> => match s.as_str() {
        "effectful" => FfiMode::Effectful,
        "benignEffectful" => FfiMode::BenignEffectful,
        "clientOnly" => FfiMode::ClientOnly,
        "serverOnly" => FfiMode::ServerOnly,
        _ => FfiMode::Effectful,
    },
};

// Right-recursive like `urweb.grm` `dtypes` / `valis` (avoids reduce/shift on `and` under LALR).
DatatypeDecls: Vec<DatatypeDecl> = {
    <d:DatatypeDecl> => vec![d],
    <d:DatatypeDecl> "and" <rest:DatatypeDecls> => { let mut v = vec![d]; v.extend(rest); v },
};

DatatypeDecl: DatatypeDecl = {
    <name:"IDENT"> <params:TyParams> "=" <constrs:DtConstrs> =>
        DatatypeDecl { name, params, constrs },
    <name:"UIDENT"> <params:TyParams> "=" <constrs:DtConstrs> =>
        DatatypeDecl { name, params, constrs },
};

TyParams: Vec<String> = {
    => vec![],
    <ps:TyParams> <p:"IDENT"> => { let mut v = ps; v.push(p); v },
};

// `dt_done` closes the list — FIRST {`dt_done`, `dt_bar`} is disjoint (no nullable `DtConstrs`).
DtConstrs: Vec<(String, Option<LocCon>)> = {
    <c:DtConstr> <tail:DtConstrTail> => { let mut v = vec![c]; v.extend(tail); v },
};

DtConstrTail: Vec<(String, Option<LocCon>)> = {
    "dt_done" => vec![],
    "dt_bar" <c:DtConstr> <rest:DtConstrTail> => { let mut v = vec![c]; v.extend(rest); v },
};

// `dt_con0` is inserted for nullary constructors so `dtype_of` is never shift/reduce-split with ε.
DtConstr: (String, Option<LocCon>) = {
    <name:"UIDENT"> "dtype_of" <c:Con> => (name, Some(c)),
    <name:"UIDENT"> "dt_con0" => (name, None),
};

ValRecBindings: Vec<(String, Option<LocCon>, LocExp)> = {
    <b:ValRecBind> => vec![b],
    <b:ValRecBind> "and" <rest:ValRecBindings> => { let mut v = vec![b]; v.extend(rest); v },
};

ValRecBind: (String, Option<LocCon>, LocExp) = {
    <name:"IDENT"> <ann:(":" <Con>)?> "=" <e:Exp> => (name, ann, e),
};

FunBindings: Vec<(String, Option<LocCon>, LocExp)> = {
    <b:FunBind> => vec![b],
    <b:FunBind> "and" <rest:FunBindings> => { let mut v = vec![b]; v.extend(rest); v },
};

FunBind: (String, Option<LocCon>, LocExp) = {
    <name:"IDENT"> <params:FnLamParams> <ret:(":" <Con>)?> "=" <e:Exp> => {
        let body = wrap_fun_params(params, e);
        (name, ret, body)
    },
};
